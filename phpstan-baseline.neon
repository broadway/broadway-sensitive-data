parameters:
	ignoreErrors:
		-
			message: '#^Method Broadway\\BroadwaySensitiveData\\EventHandling\\SensitiveData\:\:__construct\(\) has parameter \$data with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/SensitiveData.php

		-
			message: '#^Method Broadway\\BroadwaySensitiveData\\EventHandling\\SensitiveData\:\:getData\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/SensitiveData.php

		-
			message: '#^Property Broadway\\BroadwaySensitiveData\\EventHandling\\SensitiveData\:\:\$data has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/SensitiveData.php

		-
			message: '#^Parameter \#1 \$event of method Broadway\\BroadwaySensitiveData\\EventHandling\\SensitiveDataProcessor\:\:getApplyMethod\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/SensitiveDataProcessor.php
